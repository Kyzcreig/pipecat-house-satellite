CONFIG_IDF_TARGET="esp32s3"

# Enable PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=n
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Performance
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y

# Enable DTLS
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Defaults to partitions.csv
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# libpeer requires large stack allocations
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# XIAO uses GPIO43/GPIO44 for I2S; keep logs on native USB serial/JTAG.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
# CONFIG_ESP_CONSOLE_UART is not set

# Interrupt WDT stays off (bench-era choice, not in scope of t_2e80e072).
# CONFIG_ESP_INT_WDT is not set

# Unattended recovery (t_2e80e072): task WDT on app_main (init + main loop,
# subscribed explicitly in main.cpp). Idle-task checks stay OFF: the audio
# publisher legitimately saturates core 0 and must not trip a reset.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0 is not set
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set

# Brownout detector: IDF default is already on (level 7); pin it so a flickering
# outage resets cleanly instead of half-running on a sagging rail.
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y

# GADGET-4 (t_092093f1) arm (b): Muse-size Wi-Fi RX buffers (static 16 / dynamic 64).
# IDF defaults are 10 / 32 (generated sdkconfig). Each static RX buffer is ~1.6 KB of
# internal DMA-capable heap, allocated at esp_wifi_init and never freed. Measurement arm;
# lands in main ONLY on a PASS verdict (vault note shortlist #4 pass criterion).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64

# GADGET-4 arm (c): plus Muse-size AMPDU block-ack windows (TX 32 / RX 32; IDF default 6/6).
# Kconfig recommends STATIC_RX_BUFFER_NUM >= RX_BA_WIN; Muse ships 16 < 32 and this arm
# copies Muse as written in the note. Measurement arm only.
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_RX_BA_WIN=32
