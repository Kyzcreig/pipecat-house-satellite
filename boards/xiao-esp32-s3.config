# XIAO ESP32-S3 + ReSpeaker XVF3800 bench profile
#
# This is the Phase 2C bench bring-up target. It intentionally stops short of
# the XVF3800 beamforming/control driver work planned for the next phase.

[board]
idf_target = esp32s3
flash_size = 8MB
psram = octal_80mhz
project_dir = xiao-esp32-s3

[i2s]
# XVF3800 custom firmware supplies BCLK/LRCLK; the XIAO is the I2S secondary.
role = slave
sample_rate = 48000
bits_per_sample = 32
channels = stereo
bclk = GPIO8
lrclk = GPIO7
din = GPIO43
dout = GPIO44
mclk = NC

[i2c]
sda = GPIO5
scl = GPIO6
frequency = 100000
xvf3800_address = 0x2c
aic3104_address = 0x18

[webrtc]
default_offer_url = http://skynet.local:7860/api/offer
bench_tone_env = PIPECAT_BENCH_SEND_TONE
